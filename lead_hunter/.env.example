# Construction Lead Hunter AI — Local Config (.env.example)
# Copy this file to .env and fill in optional free API keys as we add phases.

# Local SQLite database path (relative to project root or absolute)
DB_PATH=data/db/leads.db

# Data directories
IMPORTS_DIR=data/imports
EXPORTS_DIR=data/exports
REPORTS_DIR=data/reports
LOGS_DIR=data/logs

# Local Ollama configuration (used starting Phase 5)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=60

# Optional free public API keys (used starting Phase 3/4)
SAM_GOV_API_KEY=
CENSUS_API_KEY=
SOCRATA_APP_TOKEN=
