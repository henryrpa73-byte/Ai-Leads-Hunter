# Zero Paid API Keys Required
# Ai Leads Hunter operates 100% free using USASpending.gov, public municipal Socrata open-data portals,
# local SQLite storage, and optional local Ollama models.

# APP_URL: Runtime URL of this application (injected automatically in AI Studio preview)
APP_URL="http://localhost:3000"

# Optional Local Ollama Configuration (loopback only, no API key required)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"

# Optional Server-Side CRM Webhook / API Tokens (CSV/JSON export works with zero keys)
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
PIPEDRIVE_API_TOKEN=
ZOHO_CRM_ACCESS_TOKEN=
CRM_WEBHOOK_URL=
